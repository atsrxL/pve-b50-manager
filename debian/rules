#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/pve-gpu-manager

# Boot services are enabled by postinst but must never run merely because a
# package was installed or upgraded; two of them can change live PCI topology.
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade
