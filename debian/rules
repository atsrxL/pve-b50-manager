#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/pve-gpu-manager

# Both services are enabled by postinst but must never run merely because a
# package was installed or upgraded; each can change a live PCI topology.
override_dh_installsystemd:
	dh_installsystemd --no-start
