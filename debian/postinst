#!/bin/sh
# Install the marked PVE integration and enable boot-time services.

set -e

PATCH_SCRIPT=/usr/lib/pve-gpu/reapply-patches.sh

log() {
    logger -t pve-gpu-postinst "$@" 2>/dev/null || true
    echo "pve-gpu-postinst: $*"
}

enable_services() {
    command -v systemctl >/dev/null 2>&1 || return 0

    systemctl daemon-reload || true
    systemctl enable pve-gpu-vfio.service \
        || log "WARNING: Failed to enable pve-gpu-vfio.service"
    systemctl enable pve-gpu-sriov.service \
        || log "WARNING: Failed to enable pve-gpu-sriov.service"
    # Never apply persisted GPU state merely because a package was installed
    # or upgraded.  The API applies explicit user changes transactionally;
    # this service restores them only during a later boot, before pve-guests.
}

case "$1" in
    configure)
        if [ ! -x "$PATCH_SCRIPT" ]; then
            log "ERROR: $PATCH_SCRIPT is missing or not executable"
            exit 1
        fi
        "$PATCH_SCRIPT" --apply
        enable_services
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
