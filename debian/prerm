#!/bin/sh
# Remove only this package's marked integration on final removal.

set -e

PATCH_SCRIPT=/usr/lib/pve-gpu/reapply-patches.sh
POWER_STATE=${PVE_GPU_POWER_STATE:-/run/pve-gpu/power-state.conf}

log() {
    logger -t pve-gpu-prerm "$@" 2>/dev/null || true
    echo "pve-gpu-prerm: $*"
}

disable_services() {
    command -v systemctl >/dev/null 2>&1 || return 0

    systemctl stop pve-gpu-sriov.service 2>/dev/null || true
    systemctl disable pve-gpu-sriov.service 2>/dev/null || true
    systemctl stop pve-gpu-vfio.service 2>/dev/null || true
    systemctl disable pve-gpu-vfio.service 2>/dev/null || true
    systemctl stop pve-gpu-power-limit.service 2>/dev/null || true
    systemctl disable pve-gpu-power-limit.service 2>/dev/null || true
    log "Stopped and disabled PVE GPU Manager services"
}

case "$1" in
    remove|deconfigure)
        if [ -s "$POWER_STATE" ]; then
            log "ERROR: A GPU is still in PGM power-saving state. Exit Power Saving under Node > GPU or reboot before removing the package."
            exit 1
        fi
        if [ -x "$PATCH_SCRIPT" ]; then
            "$PATCH_SCRIPT" --remove
        else
            log "WARNING: $PATCH_SCRIPT unavailable; marked integration could not be removed"
        fi
        disable_services
        ;;
    upgrade)
        # Keep the integration and services intact while dpkg replaces files.
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
