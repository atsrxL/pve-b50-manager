[Unit]
Description=Restore persisted Intel GPU SR-IOV configuration
Requires=pve-cluster.service
Wants=systemd-modules-load.service sys-kernel-debug.mount
After=systemd-modules-load.service sys-kernel-debug.mount pve-cluster.service pve-gpu-vfio.service
Before=pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/lib/pve-gpu/apply-sriov-config.sh
RemainAfterExit=yes
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
