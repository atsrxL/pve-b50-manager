[Unit]
Description=Bind explicitly selected PCI functions to VFIO-PCI
After=systemd-modules-load.service
Before=pve-gpu-sriov.service pve-guests.service
ConditionPathExists=/etc/pve-gpu-vfio.conf

[Service]
Type=oneshot
ExecStart=/usr/lib/pve-gpu/apply-vfio-config.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
